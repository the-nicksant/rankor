{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["build:styles", "copy:assets", "build:components"],
      "env": [
        "VITE_APP_API_URL"
      ]
    },
    "build:styles": {
      "outputs": ["dist/**"]
    },
    "copy:assets": {
      "outputs": ["dist/assets/**"]
    },
    "build:components": {
      "outputs": ["dist/components/**"]
    },
    "dev": {
      "with": ["dev:styles", "copy:assets", "dev:components"]
    },
    "dev:styles": {
      "cache": false,
      "persistent": true
    },
    "dev:components": {
      "cache": false,
      "persistent": true
    }
  }
}
