{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "jsx": "preserve",
    "target": "esnext",
    "esModuleInterop": true,
    "incremental": true,
    "skipLibCheck": true,
    "lib": ["dom", "DOM.Iterable", "ESNext"],
    "noEmit": true,
    "paths": {
      "react": ["./node_modules/@types/react"]
    }
  }
}
